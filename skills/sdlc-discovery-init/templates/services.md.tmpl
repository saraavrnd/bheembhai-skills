```yaml bheembhai:foreach
artifact: services
repo: <REPO_NAME>
generated: <DATE>
topology: single|multi            # single ONLY if the sole signal is one root manifest
summary: "<1-2 sentences: how many services, how detected; note infra deps and any components.>"
services:
  - id: <service-id>                # filesystem-safe; becomes docs/discovery/<service-id>/
    root: "<path from repo root>"
    manifest: "<pyproject.toml|package.json|composer.json|none for a Dockerfile-only service>"
    confidence: observed|inferred
    source: "<the marker that revealed it, e.g. docker-compose.yml service `api` build: .>"   # required for observed
    # basis: "<required for inferred — the facts the service/component call was inferred from>"
    # note: "<optional — the alternative reading when it is a close call>"
```
